{
  "name": "dhakaflix-pc",
  "version": "0.4.2",
  "description": "DhakaFlix - ISP Media Server Browser for Windows",
  "main": "dist/main/index.js",
  "author": "DhakaFlix",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n vite,main,electron -c cyan,magenta,yellow \"npm:dev:vite\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on http://localhost:5173 dist/preload/index.js && cross-env NODE_ENV=development electron .",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "publish:win": "npm run build && electron-builder --win nsis --x64 --publish always",
    "icon": "node scripts/make-icon.js",
    "check-version": "node scripts/check-version.js",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/jest/bin/jest.js",
    "test:e2e": "playwright test",
    "test:coverage": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "wait-on": "^7.2.0"
  }
}
